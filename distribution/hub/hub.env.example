# Generate locally: pnpm exec tsx scripts/hub-admin.ts generate-token
# Keep the real file out of Git and chmod 600 it.
COORD_HUB_ADMIN_TOKEN=
# Separate random64-hex secret shared only with the Vercel account proxy.
# Leave unset only for legacy private-admin-only use without website accounts.
COORD_PORTAL_TOKEN=
# Only needed for the optional HTTPS profile; use a hostname you control.
COORD_HUB_DOMAIN=
# Native Node startup only; Compose stores /data in its named volume.
COORD_HUB_DATA=.coord/hub
COORD_HUB_HOST=127.0.0.1
COORD_HUB_PORT=4200
