# Simplest local option: pnpm db:local (no Docker needed).
# It stores a generated credential in .coord/database-url; leave DATABASE_URL unset.
# Docker alternative: replace both placeholders with the same random password.
# POSTGRES_PASSWORD=replace-with-a-random-local-password
# DATABASE_URL=postgresql://coord:replace-with-a-random-local-password@127.0.0.1:5432/coord
COORD_HOST=127.0.0.1
PORT=4100
# Only needed for remote hosting: place the control plane behind a TLS proxy.
# Never put device tokens in source control or command-line arguments.
